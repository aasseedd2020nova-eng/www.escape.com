# Copy to .env locally. NEVER commit .env to GitHub.
NODE_ENV=development
PORT=3000
# Neon: use its POOLED PostgreSQL connection string (secret)
DATABASE_URL=
# Public HTTPS site address after deployment, without a trailing slash
BASE_URL=http://localhost:3000
# Admin login; generate ADMIN_PASSWORD_HASH using: npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Generate each independently with: openssl rand -hex 32
SESSION_SECRET=
PDF_SIGNING_SECRET=
OTP_SECRET=
# Optional WhatsApp Cloud API; without these, PDF still works and delivery is marked failed.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v23.0
# Approved WhatsApp template names/languages must match exactly in Meta Manager.
WHATSAPP_CERT_TEMPLATE=
WHATSAPP_CERT_LANGUAGE=ar
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUAGE=ar
# Optional Meta webhook status tracking
META_VERIFY_TOKEN=
META_APP_SECRET=
# Trust your reverse proxy only on a reputable HTTPS hosting provider
TRUST_PROXY=1
